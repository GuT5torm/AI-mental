# ============================================================
# 生产环境变量模板
# 使用：复制本文件为 deploy/.env（同目录），填写必填项后启动。
# compose 会自动加载 deploy/.env；本文件与 deploy/.env 均禁止提交入库。
# ============================================================

# ---- 数据库（必填）----
# 生产务必使用强密码
POSTGRES_USER=postgres
POSTGRES_PASSWORD=please_change_me

# ---- 安全密钥（必填）----
# JWT 签名密钥：base64 编码、不少于 256 bit。生成示例：
#   openssl rand -base64 48
# 注意：变更后所有已签发 token 立即失效，用户需重新登录
JWT_SECRET=
# 用户自配 API Key 的 AES-GCM 加密主密钥：base64 编码。生成示例：
#   openssl rand -base64 32
# 注意：变更后已落库密文无法解密，用户需重新保存 API Key
AI_CONFIG_SECRET=

# ---- 大模型（选填）----
# 默认 mock 演示模式（跑通链路用固定文案）。
# 真实模型推荐走管理后台「AI 配置」保存全局 Key（即时生效，无需重启）；
# 也可在此直接配置环境变量方式：
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_TEMPERATURE=0.8
AI_MAX_TOKENS=2048
AI_TIMEOUT_SECONDS=60

# ---- 跨域（选填）----
# 仅当前后端分离域名部署时填写（逗号分隔，支持 * 通配，如 https://app.example.com）。
# 默认同源反代部署（本编排默认形态）无需配置，留空即可。
CORS_ALLOWED_ORIGINS=

# ---- JVM（选填）----
# 按服务器规格调整，如 -XX:MaxRAMPercentage=75.0
JAVA_OPTS=

# ---- HTTPS（启用时填写，见 compose 内注释）----
# 1. 申请证书（示例，以 Let's Encrypt standalone 为例，需先停用占用 80 端口的服务）：
#      certbot certonly --standalone -d your-domain.com
# 2. 拷贝证书：cp /etc/letsencrypt/live/your-domain.com/fullchain.pem deploy/certs/
#              cp /etc/letsencrypt/live/your-domain.com/privkey.pem deploy/certs/
# 3. 取消 deploy/docker-compose.yml 中 frontend 的 443 映射与挂载注释后重建
